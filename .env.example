# Edge Device Security Demo - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# All IP addresses below use RFC 5737 TEST-NET documentation addresses (192.0.2.0/24).

# ── Jetson Edge Device ────────────────────────────────────────────────────────
JETSON_IP=192.0.2.20
JETSON_USER=jetson
JETSON_HOSTNAME=jetson.localdomain
JETSON_SSH_KEY=~/.ssh/id_ed25519_jetson_demo

# ── Mac Control Plane ─────────────────────────────────────────────────────────
MAC_IP=192.0.2.10
MAC_USER=m
MAC_HOSTNAME=m.localdomain
MAC_SSH_KEY=~/.ssh/id_ed25519_mac_demo

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_PORT=8200
VAULT_ADDR=https://192.0.2.10:8200
# Specify either VAULT_LICENSE_STRING or VAULT_LICENSE_PATH (not both)
VAULT_LICENSE_STRING=
VAULT_LICENSE_PATH=

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=edge_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here

# ── Services & Endpoints ──────────────────────────────────────────────────────
# CAMERA_RTSP_URL is a Control Plane seed only: vault/init-vault.sh (make setup-vault) writes it to Vault KV
# edge-ai-demo-kv/edge-device/camera-creds. The Jetson fetches it from Vault at run time and never gets it
# from this file (bootstrap-jetson.sh pushes an allow-listed .env without it).
CAMERA_RTSP_URL=rtsp://user:password@192.0.2.50:554/stream1
VLM_PORT=8090
TRUSTED_EDGE_PORT=8095
WEBUI_PORT=8443

# ── Network & Diagnostics ────────────────────────────────────────────────────
DISABLE_WIFI=true
